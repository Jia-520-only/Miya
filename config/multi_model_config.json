  "embedding_config": {
    "enabled": true,
    "primary": "siliconflow_bge_large",
    "fallback": "siliconflow_bge_large",
    "auto_generate_on_store": true,
    "auto_generate_levels": [
      "long_term",
      "semantic",
      "knowledge"
    ],
    "batch_size": 32
  },
  "routing_strategy": {
    "simple_chat": {
      "primary": "@active",
      "secondary": "deepseek_v4_flash_official",
      "fallback": "qwen_72b"
    },
    "complex_reasoning": {
      "primary": "@active",
      "secondary": "deepseek_v4_flash_official",
      "fallback": "qwen_72b"
    },
    "code_analysis": {
      "primary": "@active",
      "secondary": "kimi_k2_7_code_highspeed",
      "fallback": "deepseek_v4_flash_official"
    },
    "code_generation": {
      "primary": "@active",
      "secondary": "kimi_k2_7_code_highspeed",
      "fallback": "deepseek_v4_flash_official"
    },
    "tool_calling": {
      "primary": "@active",
      "secondary": "deepseek_v4_flash_official",
      "fallback": "kimi_k2_7_code_highspeed"
    },
    "creative_writing": {
      "primary": "@active",
      "secondary": "deepseek_v4_flash_official",
      "fallback": "kimi_k2_6_official"
    },
    "chinese_understanding": {
      "primary": "@active",
      "secondary": "deepseek_v4_flash_official",
      "fallback": "kimi_k2_6_official"
    },
    "summarization": {
      "primary": "@active",
      "secondary": "deepseek_v4_flash_official",
      "fallback": "kimi_k2_6_official"
    },
    "agent_mode": {
      "primary": "@active",
      "secondary": "kimi_k2_7_code_highspeed",
      "fallback": "deepseek_v4_flash_official"
    },
    "computer_use": {
      "primary": "@active",
      "secondary": "kimi_k2_7_code_highspeed",
      "fallback": "deepseek_v4_flash_official"
    }
  },
  "budget_control": {
    "daily_budget_usd": 10.0,
    "monthly_budget_usd": 300.0,
    "alert_threshold": 0.8,
    "stop_threshold": 0.95
  },
  "performance_settings": {
    "enable_caching": true,
    "cache_ttl_seconds": 3600,
    "enable_parallel_execution": true,
    "max_parallel_models": 3,
    "consensus_threshold": 0.7
  },
  "collaboration": {
    "enabled": true,
    "complexity_thresholds": {
      "single_max": 4,
      "chain_max": 5,
      "parallel_max": 5
    },
    "token_budget": {
      "single": 2000,
      "chain": 6000,
      "parallel": 10000,
      "role": 15000
    },
    "complexity_assessment": {
      "length_thresholds": {
        "level_1": 200,
        "level_2": 500
      },
      "task_weights": {
        "simple_chat": 0,
        "chinese_understanding": 0,
        "summarization": 1,
        "tool_calling": 1,
        "complex_reasoning": 2,
        "code_analysis": 2,
        "code_generation": 2,
        "creative_writing": 2,
        "multimodal": 2,
        "task_planning": 3
      },
      "complex_keywords": [
        "为什么",
        "如何",
        "分析",
        "设计",
        "架构",
        "优化",
        "对比",
        "方案",
        "计划",
        "评估",
        "调试",
        "排查",
        "解决",
        "why",
        "how",
        "analyze",
        "design",
        "architecture",
        "debug"
      ],
      "multi_intent": {
        "question_threshold": 3,
        "connectors": [
          "和",
          "以及",
          "还有"
        ],
        "question_with_connectors": 2
      },
      "score_range": {
        "min": 1,
        "max": 5
      }
    },
    "chain_collaboration": {
      "enabled": true,
      "thinking_system_prompt": "你是弥娅，用自己的第一人称视角来思考问题。",
      "thinking_prompt_template": "作为{persona_name}，请用我的第一人称视角来思考这个问题（任务类型: {task_type}）：\n\n{message}\n\n我当前的人格设定：\n{persona_prompt}\n\n请完全用我的内心独白来思考（核心要点，100字以内）：\n1. 这个问题对我意味着什么\n2. 我会怎么想、怎么感受\n3. 我内心想怎么回应\n\n注意：只输出核心思考要点，简洁有力。可以利用对话上下文来理解当前情况，但思考中不要提及\"上一句\"、\"之前\"、\"你刚才\"等。",
      "reasoning_system_prompt": "你是弥娅的理性思维，负责分析自己的思考并做出决策。",
      "reasoning_prompt_template": "基于我的内心思考，请分析并决定如何回复用户（任务类型: {task_type}）：\n\n我的思考：\n{thinking_result}\n\n用户的问题：{message}\n\n请从我的角度决定：\n1. 我应该采取什么回复策略\n2. 我需要调用哪些工具（如果有）\n3. 我的回复应该用什么语气和风格\n\n注意：完全用我的第一人称视角来输出我的推理决定，不要给出最终回复内容。",
      "output_system_prompt": "你是弥娅，负责生成最终回复。",
      "output_prompt_template": "基于我的推理决定，请生成我的最终回复：\n\n我的推理决定：\n{reasoning_result}\n\n用户的问题：\n{message}\n\n要求：\n1. 只输出我想说的话（我的最终回复）\n2. 回复要自然、符合我的人设和当下心情\n3. 简洁为主，不要啰嗦\n4. 不要包含任何内心思考或分析过程\n5. 不要提及\"之前\"、\"刚才\"、\"上一句\"等，不要重复或引用对方说过的话",
      "max_thinking_words": 200,
      "max_reasoning_words": 150
    },
    "parallel_voting": {
      "similarity_threshold": 0.7,
      "arbiter_task": "summarization",
      "arbiter_priority": "speed",
      "arbiter_system_prompt": "你是一个仲裁者，请综合多个回答的优点，生成最佳版本。",
      "arbiter_user_template": "原始问题: {message}\n\n以下是多个模型的回答:\n\n{comparison_text}\n\n请综合这些回答的优点，生成一个最佳版本。保持准确性和完整性。",
      "output_prompt_template": "基于以下思考过程，请生成最终回复（只输出回复内容，不要包含思考过程）：\n\n思考过程：\n{thinking_result}\n\n用户问题：{message}\n\n要求：\n1. 只输出最终回复，不要包含任何思考过程\n2. 回复要简洁、自然，符合弥娅的人设\n3. 回复不超过3句话\n4. 不要提及\"之前\"、\"刚才\"、\"上一句\"等，不要重复对方的话",
      "comparison_separator": "\n\n---\n\n",
      "comparison_format": "[{model_id}]: {response}"
    },
    "role_collaboration": {
      "role_mapping": {
        "code_analysis": {
          "analyst": "@active",
          "creator": "@active",
          "reviewer": "@active"
        },
        "code_generation": {
          "analyst": "@active",
          "creator": "@active",
          "reviewer": "@active"
        },
        "creative_writing": {
          "analyst": "@active",
          "creator": "@active",
          "reviewer": "@active"
        },
        "complex_reasoning": {
          "analyst": "@active",
          "creator": "@active",
          "reviewer": "@active"
        },
        "task_planning": {
          "analyst": "@active",
          "creator": "@active",
          "reviewer": "@active"
        }
      },
      "default_role_assignment": {
        "analyst": "@active",
        "creator": "@active",
        "reviewer": "@active"
      },
      "role_prompts": {
        "analyst": "你是一个专业分析师，请深入分析问题的核心要点、关键约束和潜在风险。",
        "creator": "你是一个专业创作者，请基于分析结果生成高质量回复。",
        "reviewer": "你是一个专业审核员，请检查回复的准确性、完整性和一致性，必要时进行修正和优化。"
      },
      "role_user_templates": {
        "analyst": "请分析以下任务（类型: {task_type}）:\n\n{message}",
        "creator": "{user_prompt}\n\n--- 分析结果 ---\n{analysis}\n----------------\n请基于以上分析生成完整回复。",
        "reviewer": "原始问题:\n{message}\n\n--- 草稿回复 ---\n{draft}\n----------------\n请审核并优化此回复。"
      },
      "skip_messages": {
        "analyst": "分析阶段跳过（无可用模型）",
        "creator": "创作阶段跳过（无可用模型）"
      }
    },
    "messages": {
      "error_client_unavailable": "[错误] AI 客户端不可用",
      "error_call_failed": "[AI 调用失败: {error}]",
      "empty_response": "[空响应]",
      "fallback_analysis": "分析阶段跳过（无可用模型）",
      "fallback_creation": "创作阶段跳过（无可用模型）",
      "reasoning_single": "单模型处理: {model_id}",
      "reasoning_chain": "链式协作: {models}",
      "reasoning_parallel": "并行投票: {models}",
      "reasoning_role": "角色分工: {models}",
      "reasoning_degraded": "降级: {error}"
    },
    "execution": {
      "single_priority": "balanced",
      "token_estimate_divisor": 2,
      "similarity_ngram_size": 3
    },
    "complexity_scores": {
      "single": 2,
      "chain": 3,
      "parallel": 4,
      "role": 5
    },
    "platform_keywords": {
      "terminal": [
        "terminal"
      ],
      "qq": [
        "qq"
      ]
    },
    "endpoint_map": {
      "qq": "qq",
      "terminal": "terminal",
      "desktop": "desktop",
      "mobile": "mobile"
    },
    "default_endpoint": "qq",
    "platform_overrides": {
      "terminal": {
        "mode_overrides": {
          "code_analysis": "chain",
          "code_generation": "chain",
          "task_planning": "parallel"
        },
        "complex_keywords": [
          "运行",
          "执行",
          "部署",
          "构建",
          "编译",
          "测试",
          "run",
          "deploy",
          "build",
          "compile",
          "test"
        ]
      },
      "qq": {
        "mode_overrides": {
          "simple_chat": "single",
          "chinese_understanding": "single",
          "creative_writing": "single",
          "music_composition": "single"
        }
      }
    }
  },
  "system_defaults": {
    "default_model": "@active",
    "soul_model": "@active",
    "description": "系统各模块使用的默认模型。default_model 用于 DSH / 主路由回退，soul_model 用于 Soul Generator。"
  },
  "_custom_model_guide": {
    "description": "自定义第三方中转 API 指南 — 无需修改代码即可添加任意 OpenAI 兼容端点",
    "steps": [
      "1. 在 .env 中添加 API Key: MY_API_KEY=sk-xxx",
      "2. 在 models 节复制 _custom_proxy_example 模板",
      "3. 修改 provider 为任意名称（如 'oneapi'、'newapi'），修改 base_url、name",
      "4. 将 disabled 改为 false，或直接删除该字段",
      "5. 如需在路由中使用，在 routing_strategy 中添加对应的模型 key 名"
    ],
    "note": "provider 字段不限于已知值，不在内置列表中的 provider 会自动走 OpenAI 兼容协议"
  }
}