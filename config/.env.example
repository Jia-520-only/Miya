# ========================================
# 弥娅 MIYA - 配置文件
# ========================================
# 复制此文件为 config/.env 并填入实际值
# 注意：不要将此文件提交到公开仓库！

# ========================================
# 应用基础配置
# ========================================
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/miya.log

# ========================================
# AI大模型配置
# ========================================
# 通用AI参数
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
AI_REQUEST_MAX_RETRIES=2
AI_REQUEST_TIMEOUT=30
AI_PROVIDER=siliconflow

# --- 硅基流动（推荐，首选） ---
SILICONFLOW_API_KEY=YOUR_SILICONFLOW_API_KEY
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- DeepSeek 官方 ---
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# --- 月之暗面 Moonshot / Kimi ---
MOONSHOT_API_KEY=YOUR_MOONSHOT_API_KEY

# --- 代理 / 中转站（兼容 OpenAI 格式） ---
PROXY_API_KEY=YOUR_PROXY_API_KEY
PROXY_API_BASE=YOUR_PROXY_API_BASE
PROXY_MODEL=YOUR_PROXY_MODEL
PROXY_IMAGE_MODEL=YOUR_PROXY_IMAGE_MODEL

# --- 智谱AI ---
ZHIPU_API_KEY=YOUR_ZHIPU_API_KEY
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4

# --- 阿里云通义千问 ---
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# --- Tavily AI 搜索（专为 AI 设计的搜索引擎） ---
# 注册地址: https://tavily.com/
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# --- Pixiv 登录 Cookie（可选） ---
# 配置后可搜索/下载 R18 作品（浏览器登录 pixiv 后复制 PHPSESSID）
# 格式: PHPSESSID=你的会话ID
PIXIV_COOKIE=

# ========================================
# Grok AI 配置
# ========================================
GROK_API_KEY=YOUR_GROK_API_KEY
GROK_MODEL=grok-2-1212

# ========================================
# AI绘画引擎 API Keys
# ========================================
# OpenAI DALL·E
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# NovelAI Diffusion (动漫风)
NOVELAI_API_KEY=YOUR_NOVELAI_API_KEY
# Stable Diffusion WebUI (本地，不用 API key)
# SD_WEBUI_URL=http://127.0.0.1:7860
# ComfyUI (本地)
# COMFYUI_URL=http://127.0.0.1:8188

# ========================================
# QQ机器人配置
# ========================================
QQ_ONEBOT_WS_URL=ws://localhost:3001
QQ_ONEBOT_TOKEN=
QQ_BOT_QQ=YOUR_QQ_BOT_QQ
QQ_SUPERADMIN_QQ=YOUR_QQ_NUMBER
QQ_RECONNECT_INTERVAL=5.0
QQ_PING_INTERVAL=20
QQ_MAX_MESSAGE_SIZE=104857600
QQ_OCR_ENABLED=true
QQ_ACTIVE_CHAT_ENABLED=true

# ========================================
# 人格配置
# ========================================
PERSONALITY_WARMTH=0.5
PERSONALITY_LOGIC=0.7
PERSONALITY_CREATIVITY=0.8
PERSONALITY_EMPATHY=0.6
PERSONALITY_RESILIENCE=0.7

# ========================================
# 情绪配置
# ========================================
EMOTION_DECAY_RATE=0.1

# ========================================
# 记忆配置
# ========================================
MEMORY_TIDE_TTL=3600
MEMORY_SHORT_TERM_CAPACITY=20

# ========================================
# Runtime API配置
# ========================================
API_ENABLED=true
API_HOST=0.0.0.0
API_PORT=8000
WEB_API_CORS_ORIGINS=*

# ========================================
# 性能配置
# ========================================
MIYA_FORCE_CPU=true

# ========================================
# 安全配置
# ========================================
INJECTION_DETECTION_ENABLED=true

# ========================================
# LifeBook配置
# ========================================
LIFEBOOK_ENABLED=true
LIFEBOOK_BASE_DIR=data/lifebook
LIFEBOOK_DEFAULT_MONTHS_BACK=1

# ========================================
# 对话上下文配置
# ========================================
CONVERSATION_CONTEXT_MAX_COUNT=5
CONVERSATION_CONTEXT_MAX_TOKENS=1000

# ========================================
# GitHub配置
# ========================================
GITHUB_REPO_OWNER=YOUR_GITHUB_REPO_OWNER
GITHUB_REPO_NAME=YOUR_GITHUB_REPO_NAME
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
GITHUB_BRANCH=main

# ========================================
# PaddleOCR配置
# ========================================
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# ========================================
# 多平台配置
# ========================================
# QQ 官方机器人
QQ_APPID=YOUR_QQ_APPID
QQ_SECRET=YOUR_QQ_SECRET
QQ_OFFICIAL_BOT_QQ=YOUR_QQ_OFFICIAL_BOT_QQ
# Telegram
TELEGRAM_BOT_TOKEN=
# Discord
DISCORD_BOT_TOKEN=
# 飞书
LARK_APP_ID=YOUR_LARK_APP_ID
LARK_APP_SECRET=YOUR_LARK_APP_SECRET
# KOOK
KOOK_TOKEN=
# Slack
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
# 钉钉
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# LINE
LINE_CHANNEL_SECRET=
# Satori
SATORI_WS_URL=ws://127.0.0.1:5500
# 企业微信
WECOM_CORP_ID=
WECOM_SECRET=
# 微信公众号
WEIXIN_APP_ID=
WEIXIN_APP_SECRET=

# ========================================
# 安全/资产搜索引擎 API Keys
# ========================================
# FOFA (https://fofa.info/)
FOFA_API_KEY=
FOFA_EMAIL=
# Shodan (https://account.shodan.io/)
SHODAN_API_KEY=
# Censys (https://search.censys.io/account/api)
CENSYS_API_ID=
CENSYS_API_SECRET=
# Quake (https://quake.360.cn/)
QUAKE_API_KEY=
# ZoomEye (https://www.zoomeye.org/)
ZOOMEYE_API_KEY=

# ========================================
# 其他工具 API Keys
# ========================================
# SerpAPI (https://serpapi.com/) — web_search 引擎
SERPAPI_API_KEY=
# 心知天气 (https://www.seniverse.com/) — weather_query 工具
SENIVERSE_API_KEY=
# Embedding 模型（知识库向量化）
EMBEDDING_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=text-embedding-3-small
# WebNet JWT 签名密钥（生产环境务必修改）
MIYA_SECRET_KEY=

# ========================================
# Beaver 服务
# ========================================
BEAVER_SERVER_URL=
