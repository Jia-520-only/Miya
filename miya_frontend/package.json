{
  "name": "miya-agent",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "prepare:audio": "node scripts/generate-audio-manifest.mjs",
    "lint": "node scripts/run-eslint.mjs",
    "lint:fix": "node scripts/run-eslint.mjs --fix",
    "dev": "npm run prepare:audio && node scripts/esbuild-electron.mjs && cross-env ESBUILD_ELECTRON=1 vite",
    "dev:web": "npm run prepare:audio && cross-env WEB_ONLY=1 vite",
    "dev:all": "npm run prepare:audio && node scripts/esbuild-electron.mjs && cross-env ESBUILD_ELECTRON=1 MIYA_START_BACKEND=1 vite",
    "build": "node scripts/run-build.mjs",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^6.5.10",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@types/markdown-it": "^14.1.2",
    "@vueuse/core": "^14.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.13.4",
    "camelcase-keys": "^10.0.2",
    "electron-updater": "^6.7.3",
    "iterator-helper": "^1.3.4",
    "markdown-it": "^14.1.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "snakecase-keys": "^9.0.2",
    "vue": "^3.5.24",
    "vue-router": "^5.0.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "cross-env": "^10.1.0",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.3",
    "unocss": "^66.6.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^0.29.0",
    "vue-tsc": "^3.1.4"
  },
  "overrides": {
    "gh-pages": "^5.0.0"
  },
  "build": {
    "appId": "com.miya.desktop",
    "productName": "Miya",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      },
      {
        "from": "resources/deepseek-harness",
        "to": "deepseek-harness"
      },
      {
        "from": "resources/dsh-tui",
        "to": "dsh-tui"
      },
      {
        "from": "premium-assets",
        "to": "premium-assets"
      }
    ],
    "win": {
      "target": "zip",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
